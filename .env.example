NODE_ENV=development
PORT=3000
STORAGE=memory
MONGODB_URI=mongodb://localhost:27017/acm-studio
# Persistent directory for uploaded attendee photos (e.g. /data/photos in Docker volume)
# Defaults to os.tmpdir()/acm-studio if unset
PHOTOS_DIR=
# Comma-separated CORS allowed origins (e.g. your Vercel frontend: https://acm-studio.vercel.app,http://localhost:5173)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
# Thinking level for Gemini: minimal, low, medium, high (default: low). Empty to omit thinkingConfig.
GEMINI_THINKING_LEVEL=low
# Groq fallback configuration (called only on transient Gemini errors e.g. 502/503/504/timeouts)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
